# ============================================================
# 별무리 고등학교 AI 스케줄 비서 - 환경 변수 설정 예시
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env
# ============================================================

# --- 필수: Gemini API 키 ---------------------------------------------------
# 발급 방법은 README.md의 "Gemini API 키 발급 가이드" 참고
# 무료로 발급받을 수 있고, 신용카드 등록이 필요 없습니다.
GEMINI_API_KEY=여기에_발급받은_API_키를_붙여넣으세요

# 사용할 모델 (기본값 gemini-2.5-flash 를 권장합니다)
# 요청 한도가 더 필요하면 gemini-2.5-flash-lite 로 바꿔보세요.
GEMINI_MODEL=gemini-2.5-flash

# --- 필수: Flask 세션 암호화 키 ---------------------------------------------
# 아무 랜덤 문자열이나 넣으면 됩니다. (터미널에서 생성: python -c "import secrets; print(secrets.token_hex(16))")
FLASK_SECRET_KEY=change-this-to-a-random-string

# --- 선택: Google Drive/Docs 연동 (없어도 AI 비서는 정상 작동합니다) --------
# Google Cloud Console > APIs & Services > OAuth 클라이언트 ID(웹 애플리케이션)에서 발급
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/google/oauth2callback
